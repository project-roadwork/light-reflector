{
  "lsp": {
    "luau-lsp": {
      "settings": {
        "luau-lsp": {
          "sourcemap": {
            "rojoProjectFile": "roblox-test.project.json",
          },
        },
        "fflags": {
          "enable_new_solver": true,
          "enable_by_default": true,
          "sync": true,
        },
        "ext": {
          "roblox": {
            "enabled": true,
            "security_level": "plugin",
          },
        },
      },
    },
  },
  "languages": {
    "Luau": {
      "formatter": {
        "external": {
          "command": "stylua",
          "arguments": ["-"],
        },
      },
    },
  },
}
